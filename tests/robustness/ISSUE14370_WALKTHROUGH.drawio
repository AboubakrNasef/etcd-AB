                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Code map Ã‚Â· scenario and orchestration" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="40" y="24" width="1320" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="desc" value="Entry points select the scenario, start the process, coordinate workers, and run validation." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#475569;" vertex="1" parent="1">
                    <mxGeometry x="42" y="76" width="1300" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;scenarios/scenarios.go Ã‚Â· Regression(t)&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;Reads the etcd binary version, then builds regression scenarios. Issue14370 sets the panic failpoint, medium KV profile, default compaction, one-member cluster, and failpoint instrumentation.&lt;br&gt;TestScenario is configuration passed to the runner; it does not execute workload traffic.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#dbeafe;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="40" y="145" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;main_test.go Ã‚Â· TestMain / TestRobustnessRegression&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;TestMain delegates process setup and flag parsing to the shared E2E runner, including the etcd binary path.&lt;br&gt;TestRobustnessRegression calls BeforeTest, iterates Regression scenarios, starts one cluster per subtest, defers cleanup, then calls testRobustness.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#dcfce7;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="740" y="145" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;framework/e2e/cluster.go Ã‚Â· NewEtcdProcessCluster&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;Applies cluster options, initializes, and starts configured EtcdServerProcess instances. With cluster size 1, this is one real child process and one data directory.&lt;br&gt;WithGoFailEnabled(true) configures failpoint support.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#fef3c7;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="40" y="400" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;framework/e2e/etcd_process.go Ã‚Â· Start / Restart / Wait&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;Start spawns etcd and waits for the ready log line. Wait observes child exit. Restart is stop then start; Start uses the same process config and data path, so recovery reads prior disk state.&lt;br&gt;BinaryFailpoints.SetupHTTP activates a failpoint in the child.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#f3e8ff;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="740" y="400" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;main_test.go Ã‚Â· testRobustness(ctx, Ã¢â‚¬Â¦)&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;Creates TestReport, runs runScenario, stores client reports, and copies server data. Then PersistedRequestsCluster reads committed WAL requests and ValidateAndReturnVisualize compares them with client history.&lt;br&gt;Finalize retains failed/panicked reports and removes clean reports unless PERSIST_RESULTS exists.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#ffe4e6;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="40" y="655" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="n6" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;main_test.go Ã‚Â· runScenario(ctx, Ã¢â‚¬Â¦)&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;Creates a cancellable context and launches workers in an errgroup: delayed failure injection, SimulateTraffic, and CollectClusterWatchEvents. Joins workers, checks final HashKV, then combines traffic, watch, and failpoint reports.&lt;br&gt;WaitBeforeFailpoint / WaitAfterFailpoint are 1 s, each with Ã‚Â±200 ms jitter.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#e0f2fe;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="740" y="655" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="e1_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n1" target="n2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e1_3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n1" target="n3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3_4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2_5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n2" target="n5">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4_6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n4" target="n6">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5_6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n5" target="n6">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="3" name="Code map Ã‚Â· traffic and observation">
        <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Code map Ã‚Â· traffic and observation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="40" y="24" width="1320" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="desc" value="Traffic uses real clientv3 requests. Recording and passive watches preserve evidence across the crash." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#475569;" vertex="1" parent="1">
                    <mxGeometry x="42" y="76" width="1300" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;traffic/traffic.go Ã‚Â· KeyValueMedium&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;Profile: 6 member-endpoint clients + 2 cluster-endpoint clients; minimum 100 QPS; maximum 200 QPS; burst 1000; max 3 concurrent non-unique writes.&lt;br&gt;CompactionDefault runs every 200 ms. Request timeout is 200 ms.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#dbeafe;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="40" y="145" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;traffic/traffic.go Ã‚Â· SimulateTraffic(ctx, Ã¢â‚¬Â¦)&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;Creates one shared rate limiter, verifies the database starts empty, generates ten-key KV workload, and optionally starts watch and compaction loops. Here KV and compaction run; generated watch traffic is nil.&lt;br&gt;Waits for failpoint timing, stops generators, and returns their reports.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#dcfce7;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="740" y="145" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;traffic/etcd.go Ã‚Â· EtcdPutDeleteLease&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;Weighted random choices (weights total 100): Get 15; list forms 15; stale reads/lists 20; Put 20; Delete 5; multi-op transaction 10; leased Put 5; lease revoke 5; compare-and-set 5.&lt;br&gt;Delete/revoke may be temporarily suppressed at the non-unique write concurrency cap.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#fef3c7;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="40" y="400" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;client/client.go Ã‚Â· RecordingClient&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;Wraps clientv3. KV methods serialize calls per client, timestamp call/return against one monotonic base, and record request plus response. Each client and write request gets IDs.&lt;br&gt;A failed write can be ambiguous: no response does not prove the server did not persist it.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#f3e8ff;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="740" y="400" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;client/watch.go Ã‚Â· CollectClusterWatchEvents&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;Starts a passive watch at each member endpoint. watchUntilRevision requests progress every 100 ms, tracks observed revisions, resumes after compaction cancellation, and exits at the workload&#39;s max revision.&lt;br&gt;No generated watch clients exist in this scenario; this collector still records watch evidence.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#ffe4e6;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="40" y="655" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="n6" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;Report streams Ã‚Â· combined observations&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;runScenario returns RecordingClient KV histories, passive watch reports, and failpoint-trigger reports. OperationsMaxRevision supplies the watch completion target.&lt;br&gt;Traffic and failure workers overlap intentionally, creating the timing window around the crash.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#e0f2fe;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="740" y="655" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="e1_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n1" target="n2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2_3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n2" target="n3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3_4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4_5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n4" target="n5">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5_6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n5" target="n6">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="4" name="Code map Ã‚Â· panic, WAL, and validation">
        <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Code map Ã‚Â· panic, WAL, and validation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="40" y="24" width="1320" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="desc" value="The failure boundary and independent end checks: cluster hash consistency, then client-history validation." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#475569;" vertex="1" parent="1">
                    <mxGeometry x="42" y="76" width="1300" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;failpoint/failpoint.go Ã‚Â· Inject(ctx, Ã¢â‚¬Â¦)&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;Applies a timeout, checks each member is SERVING before and after injection, records start/end times, and returns timing plus any failpoint client reports.&lt;br&gt;A health-check or injection error propagates to runScenario.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#dbeafe;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="40" y="145" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;failpoint/gofail.go Ã‚Â· goPanicFailpoint.Inject&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;Chooses the target member, activates its failpoint over HTTP with payload panic, waits for child exit, then calls member.Start(ctx). Issue14370 uses AnyMember; with one member that is the sole process.&lt;br&gt;Registered failpoint name: raftBeforeSave.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#dcfce7;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="740" y="145" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;server/etcdserver/raft.go Ã‚Â· raftBeforeSave&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;The gofail hook sits directly before r.storage.Save(rd.HardState, rd.Entries). When activated, the next Raft Ready batch reaching this location panics before the save call.&lt;br&gt;This targets the WAL persistence boundary for entries and hard state.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#fef3c7;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="40" y="400" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;client/kvhash.go Ã‚Â· CheckEndOfTestHashKV&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;Reads the cluster hash/revision, then asks each member for its hash at that same revision. Errors if revisions, compact revisions, or hashes differ.&lt;br&gt;A single-member run checks recovered state but cannot compare independent peers.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#f3e8ff;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="740" y="400" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;report/wal.go Ã‚Â· PersistedRequestsCluster Ã¢â€ â€™ PersistedRequests&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;Collects member data directories, reads WAL hard state and entries, merges entries up to the minimum commit index, and parses committed normal Raft entries into model requests.&lt;br&gt;ReadWAL can repair one unexpected-EOF tail and retry once.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#ffe4e6;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="40" y="655" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="n6" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;validate/validate.go Ã‚Â· ValidateAndReturnVisualize&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;Checks model assumptions, classifies client operations, optionally patches linearizable operations from persisted requests, then runs Porcupine. If linearization fails, later checks are skipped. On success, replays WAL requests for watch and serializable-read checks.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#e0f2fe;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="740" y="655" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="e1_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n1" target="n2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2_3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n2" target="n3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3_4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4_5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n4" target="n5">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5_6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n5" target="n6">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="5" name="Code map Ã‚Â· model and report internals">
        <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Code map Ã‚Â· model and report internals" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="40" y="24" width="1320" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="desc" value="Model methods explain ambiguous outcomes; report methods retain the evidence needed to investigate a run." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#475569;" vertex="1" parent="1">
                    <mxGeometry x="42" y="76" width="1300" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;model/non_deterministic.go Ã‚Â· NonDeterministicModel / apply&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;Creates an etcd model for Porcupine. A failed request forks possible states: it may have persisted or been lost. A successful response filters states to those consistent with that result.&lt;br&gt;Equal compares candidate states; compareStates orders them by revision, KV contents, and leases.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#dbeafe;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="40" y="145" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;model/non_deterministic.go Ã‚Â· applyPersistedRequest&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;Applies requests recovered from WAL to every possible model state, with or without a known revision. This provides the replay state used to check observed watches and serializable reads against durable server history.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#dcfce7;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="740" y="145" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;validate/operations.go Ã‚Â· linearizable check&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;validateLinearizableOperationsAndVisualize calls porcupine.CheckOperationsVerbose with the nondeterministic etcd model and timeout. It returns success, illegal, or timeout and stores visualization metadata.&lt;br&gt;Failed client requests get an unbounded return time during linearizability analysis because commit timing is unknown.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#fef3c7;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="40" y="400" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;validate/operations.go Ã‚Â· serializable read check&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;validateSerializableOperations iterates eligible reads. validateSerializableRead gets model state at the requested revision, steps the request, and compares the expected range response with the observed one.&lt;br&gt;Persisted or errored reads are skipped; future-revision errors are treated as expected.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#f3e8ff;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="740" y="400" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;report/report.go Ã‚Â· SaveEtcdData / Finalize&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;SaveEtcdData copies each member data directory, client operation/watch reports, and traffic details into the run report directory.&lt;br&gt;Finalize keeps artifacts for test failure, panic, or PERSIST_RESULTS; otherwise it removes the successful report. If available, it writes history.html visualization.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#ffe4e6;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="40" y="655" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="n6" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:10px&quot;&gt;report/wal.go Ã‚Â· ReadWAL / parseEntryNormal&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.35&quot;&gt;ReadWAL reads the WAL and repairs at most one unexpected-EOF tail. parseEntryNormal decodes Raft request protobufs into model operations and ignores non-request/configuration entries.&lt;br&gt;The resulting persisted view is independent from client response logs.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;strokeWidth=2;strokeColor=#64748b;fillColor=#e0f2fe;fontColor=#0f172a;" vertex="1" parent="1">
                    <mxGeometry x="740" y="655" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="e1_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n1" target="n2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e1_3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n1" target="n3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3_4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2_4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n2" target="n4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4_5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n4" target="n5">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5_6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n5" target="n6">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
