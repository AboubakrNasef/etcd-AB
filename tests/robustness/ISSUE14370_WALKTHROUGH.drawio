                <mxCell id="boot" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;strokeColor=#64748b;fillColor=#fef3c7;fontColor=#0f172a;" value="&lt;div style=&quot;font-size:19px;font-weight:bold;margin-bottom:8px&quot;&gt;Boot real etcd process&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.3&quot;&gt;TestRobustnessRegression starts a local child via the E2E harness. Wait for readiness; use a fresh data directory for this test run.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="125" width="360" x="1080" y="120" as="geometry"/>
                </mxCell>
                <mxCell id="fork" parent="1" style="shape=hexagon;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;strokeColor=#334155;fillColor=#cbd5e1;fontColor=#0f172a;" value="&lt;div style=&quot;font-size:19px;font-weight:bold;margin-bottom:8px&quot;&gt;Start workers&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.3&quot;&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="75" width="110" x="805" y="285" as="geometry"/>
                </mxCell>
                <mxCell id="laneA" parent="1" style="text;html=1;strokeColor=none;fillColor=#dbeafe;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1e3a8a;" value="KV traffic + compaction" vertex="1">
                    <mxGeometry height="42" width="570" x="45" y="370" as="geometry"/>
                </mxCell>
                <mxCell id="laneB" parent="1" style="text;html=1;strokeColor=none;fillColor=#dcfce7;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#14532d;" value="Passive watch collector" vertex="1">
                    <mxGeometry height="42" width="570" x="675" y="370" as="geometry"/>
                </mxCell>
                <mxCell id="laneC" parent="1" style="text;html=1;strokeColor=none;fillColor=#f3e8ff;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#581c87;" value="Failpoint + process recovery" vertex="1">
                    <mxGeometry height="42" width="570" x="1305" y="370" as="geometry"/>
                </mxCell>
                <mxCell id="traffic1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;strokeColor=#3b82f6;fillColor=#eff6ff;fontColor=#0f172a;" value="&lt;div style=&quot;font-size:19px;font-weight:bold;margin-bottom:8px&quot;&gt;Generate mixed requests&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.3&quot;&gt;8 recording clients (6 member + 2 cluster endpoints); 10 keys; shared limiter up to 200 QPS, requires at least 100 QPS. Reads, puts, deletes, transactions and leases.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="570" x="45" y="425" as="geometry"/>
                </mxCell>
                <mxCell id="traffic2" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;strokeColor=#3b82f6;fillColor=#eff6ff;fontColor=#0f172a;" value="&lt;div style=&quot;font-size:19px;font-weight:bold;margin-bottom:8px&quot;&gt;Overlap the crash window&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.3&quot;&gt;Requests keep running while etcd panics and restarts. Compaction runs every 200 ms. Individual client calls are timestamped with their outcomes.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="570" x="45" y="610" as="geometry"/>
                </mxCell>
                <mxCell id="traffic3" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;strokeColor=#3b82f6;fillColor=#eff6ff;fontColor=#0f172a;" value="&lt;div style=&quot;font-size:19px;font-weight:bold;margin-bottom:8px&quot;&gt;Finish workload after recovery&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.3&quot;&gt;Stop generators, await outstanding calls, send one final successful put, and publish the maximum observed revision for watch completion.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="570" x="45" y="795" as="geometry"/>
                </mxCell>
                <mxCell id="watch1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;strokeColor=#22c55e;fillColor=#f0fdf4;fontColor=#0f172a;" value="&lt;div style=&quot;font-size:19px;font-weight:bold;margin-bottom:8px&quot;&gt;Watch from the next revision&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.3&quot;&gt;One passive stream per member; no generated watch workload for this scenario. Record events and progress responses.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="570" x="675" y="425" as="geometry"/>
                </mxCell>
                <mxCell id="watch2" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;strokeColor=#22c55e;fillColor=#f0fdf4;fontColor=#0f172a;" value="&lt;div style=&quot;font-size:19px;font-weight:bold;margin-bottom:8px&quot;&gt;Request progress / handle compaction&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.3&quot;&gt;Request progress every 100 ms. If compaction cancels a stream, resume from its compact revision.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="570" x="675" y="610" as="geometry"/>
                </mxCell>
                <mxCell id="watch3" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;strokeColor=#22c55e;fillColor=#f0fdf4;fontColor=#0f172a;" value="&lt;div style=&quot;font-size:19px;font-weight:bold;margin-bottom:8px&quot;&gt;Drain through max revision&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.3&quot;&gt;Stop only after the KV workload reports its maximum revision and the collector observes through it.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="570" x="675" y="795" as="geometry"/>
                </mxCell>
                <mxCell id="fail1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;strokeColor=#a855f7;fillColor=#faf5ff;fontColor=#0f172a;" value="&lt;div style=&quot;font-size:19px;font-weight:bold;margin-bottom:8px&quot;&gt;Wait, check health, activate panic&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.3&quot;&gt;After ~1 s (Â±200 ms), verify member health; configure raftBeforeSave=panic over failpoint HTTP. After injection, allow another ~1 s (Â±200 ms) before traffic stops.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="570" x="1305" y="425" as="geometry"/>
                </mxCell>
                <mxCell id="fail2" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;strokeColor=#a855f7;fillColor=#faf5ff;fontColor=#0f172a;" value="&lt;div style=&quot;font-size:19px;font-weight:bold;margin-bottom:8px&quot;&gt;Panic at the persistence boundary&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.3&quot;&gt;Raft reaches the hook immediately before storage.Save(HardState, Entries). The next arrival panics the etcd child process.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="570" x="1305" y="610" as="geometry"/>
                </mxCell>
                <mxCell id="fail3" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;strokeColor=#a855f7;fillColor=#faf5ff;fontColor=#0f172a;" value="&lt;div style=&quot;font-size:19px;font-weight:bold;margin-bottom:8px&quot;&gt;Wait for exit, restart same member&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.3&quot;&gt;goPanicFailpoint.Inject waits for child exit, then starts it again with the same process configuration and data directory. Traffic remains active during recovery.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="570" x="1305" y="795" as="geometry"/>
                </mxCell>
                <mxCell id="join" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;strokeColor=#334155;fillColor=#e2e8f0;fontColor=#0f172a;" value="&lt;div style=&quot;font-size:19px;font-weight:bold;margin-bottom:8px&quot;&gt;runScenario joins the workers&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.3&quot;&gt;Collect KV/failpoint reports and watch reports. Once all workers finish, compare the recovered cluster&#39;s final hash and revision.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="120" width="570" x="690" y="1010" as="geometry"/>
                </mxCell>
                <mxCell id="hash" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;strokeColor=#f97316;fillColor=#fff7ed;fontColor=#0f172a;" value="&lt;div style=&quot;font-size:19px;font-weight:bold;margin-bottom:8px&quot;&gt;CheckEndOfTestHashKV&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.3&quot;&gt;Hash each member at a common revision; report mismatched revisions, compact revisions, or hashes. With one member this checks recovery, not peer agreement.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="155" width="500" x="65" y="1190" as="geometry"/>
                </mxCell>
                <mxCell id="save" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;strokeColor=#f97316;fillColor=#fff7ed;fontColor=#0f172a;" value="&lt;div style=&quot;font-size:19px;font-weight:bold;margin-bottom:8px&quot;&gt;Save report + read committed WAL&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.3&quot;&gt;SaveEtcdData copies server data and client reports. PersistedRequestsCluster reads WAL entries, merges committed history, and decodes normal Raft requests.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="155" width="550" x="700" y="1190" as="geometry"/>
                </mxCell>
                <mxCell id="validate" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;strokeColor=#f97316;fillColor=#fff7ed;fontColor=#0f172a;" value="&lt;div style=&quot;font-size:19px;font-weight:bold;margin-bottom:8px&quot;&gt;Validate client history&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.3&quot;&gt;ValidateAndReturnVisualize checks assumptions, then asks Porcupine whether operations fit etcd semantics and recorded real-time order.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="155" width="470" x="1385" y="1190" as="geometry"/>
                </mxCell>
