                <mxCell id="scenario" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;strokeColor=#64748b;fillColor=#dcfce7;fontColor=#0f172a;" value="&lt;div style=&quot;font-size:19px;font-weight:bold;margin-bottom:8px&quot;&gt;Configure Issue14370&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.3&quot;&gt;Regression(t): 1 member, GoFail enabled, RaftBeforeSavePanic, EtcdPutDeleteLease, KeyValueMedium, CompactionDefault (200 ms).&lt;/div&gt;" vertex="1">
